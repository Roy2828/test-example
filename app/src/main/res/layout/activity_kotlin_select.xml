<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Kotlin select 表达式演示"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#333333"
        android:layout_marginBottom="4dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="kotlinx.coroutines.selects.select"
        android:textSize="13sp"
        android:textColor="#888888"
        android:layout_marginBottom="16dp" />

    <!-- 操作按钮区域 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_channel_select"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:text="通道竞速"
            android:textAllCaps="false"
            android:textSize="13sp"
            android:backgroundTint="#4CAF50" />

        <Button
            android:id="@+id/btn_deferred_select"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="协程竞速"
            android:textAllCaps="false"
            android:textSize="13sp"
            android:backgroundTint="#2196F3" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_channel_all"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:text="通道遍历"
            android:textAllCaps="false"
            android:textSize="13sp"
            android:backgroundTint="#FF9800" />

        <Button
            android:id="@+id/btn_deferred_all"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="协程遍历"
            android:textAllCaps="false"
            android:textSize="13sp"
            android:backgroundTint="#9C27B0" />
    </LinearLayout>

    <Button
        android:id="@+id/btn_clear"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_marginTop="8dp"
        android:text="清空日志"
        android:textAllCaps="false"
        android:textSize="13sp"
        android:backgroundTint="#607D8B"
        android:layout_gravity="center_horizontal" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="演示日志"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="#333333" />

    <TextView
        android:id="@+id/tv_select_log"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp"
        android:background="@android:color/white"
        android:padding="12dp"
        android:scrollbars="vertical"
        android:textSize="13sp"
        android:textColor="#333333"
        android:typeface="monospace"
        android:lineSpacingExtra="3dp" />

</LinearLayout>
